# Serve prerendered files directly where they exist
/menu/*    /menu/index.html    200
/reviews/*    /reviews/index.html    200
/catering/*    /catering/index.html    200
/contact-us/*    /contact-us/index.html    200
/meet-us/*    /meet-us/index.html    200

# Proxy /admin to Sync Portal
/admin              https://portal.syncgr.com/admin    200
/admin/*            https://portal.syncgr.com/admin/:splat    200

# Fallback to root index.html for unmatched routes (SPA behavior)
/*    /index.html    200
